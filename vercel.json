{
  "name": "hrms-separation",
  "builds": [
    {
      "src": "back-end/package.json",
      "use": "@vercel/next",
      "config": {
        "distDir": ".next"
      }
    },
    {
      "src": "front-end/package.json",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "npm run build",
        "outputDirectory": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/back-end/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/front-end/$1"
    }
  ]
}
